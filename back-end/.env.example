# Copy to .env and fill in. Never commit .env.
#
#   forge script script/new/DeployBlockdom.s.sol:DeployBlockdom \
#     --rpc-url sepolia --account deployer --broadcast --verify

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<project-id>
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# One Etherscan V2 key covers Sepolia, Base and Base Sepolia.
ETHERSCAN_API_KEY=

# Final owner of both contracts and holder of the unpooled supply.
# Optional on testnets (defaults to the deployer); REQUIRED on Base mainnet.
TREASURY=

# Optional overrides of the per-network defaults in script/new/DeployConfig.sol
# LAND_PRICE=2000000000000000
# POOL_BMT=25000000000000000000000000
# POOL_GOODS=50000000000000000000000000
